{
  "name": "omegasim-ios",
  "private": true,
  "version": "1.0.0",
  "description": "iOS shell for OmegaSim using the same web application and BLE bridge",
  "scripts": {
    "postinstall": "node scripts/patch-bluetooth-le.mjs",
    "www": "python3 ../tools/ios_www.py",
    "sync": "npm run www && npx cap sync ios",
    "open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
